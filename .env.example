# ============================================================
# CipherStream Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# App
NEXT_PUBLIC_APP_NAME=CipherStream
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Arbitrum Sepolia Network (Chain ID: 421614)
NEXT_PUBLIC_ARBITRUM_SEPOLIA_CHAIN_ID=421614
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Smart Contract — fill in AFTER deploying with Hardhat
# Run: npx hardhat run scripts/deploy.ts --network arbitrumSepolia
NEXT_PUBLIC_CIPHERSTREAM_CONTRACT_ADDRESS=replace_after_deployment

# Pinata IPFS — server-side only, NEVER expose to frontend
# Get your JWT at https://app.pinata.cloud/keys
PINATA_JWT=your_pinata_jwt_here

# Your Pinata dedicated gateway (e.g. your-name.mypinata.cloud)
PINATA_GATEWAY=your-gateway.mypinata.cloud
# Public-facing gateway for frontend (can be same as PINATA_GATEWAY)
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud

# Hardhat deployment wallet — NEVER expose, NEVER commit
# Use a test wallet only, no real funds
PRIVATE_KEY=your_test_wallet_private_key_without_0x_prefix

# Optional: Arbiscan API key for contract verification
ARBISCAN_API_KEY=optional_for_contract_verification

# Upload limits
NEXT_PUBLIC_MAX_VIDEO_SIZE_MB=50
